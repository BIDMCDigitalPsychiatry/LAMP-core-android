<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Full screen camera preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Blue header bar on top of preview -->
    <View
        android:id="@+id/topBorder"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="#7599FF"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />

    <!-- Heading title -->
    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/txt_video_recording"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="@id/topBorder"
        app:layout_constraintBottom_toBottomOf="@id/topBorder"
        app:layout_constraintStart_toStartOf="@id/topBorder"
        app:layout_constraintEnd_toEndOf="@id/topBorder" />

    <!-- Progress bar at top -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:progressTint="#2196F3"
        android:progressBackgroundTint="#33FFFFFF"
        android:max="100"
        android:progress="0"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Timer -->
    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0:00 / 1:00"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:fontFamily="sans-serif-light"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Submit button (shown after stop) -->
    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="250dp"
        android:layout_height="40dp"
        android:text="@string/txt_submit"
        android:textColor="@color/submit_button_text_color"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:background="@drawable/bg_button_outlined_blue"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:visibility="gone"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnRecord"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Close button - top left -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:src="@drawable/ic_back_button"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="#FFFFFF" />

    <!-- Camera flip button - top right -->
    <ImageButton
        android:id="@+id/btnFlipCamera"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_flip_camera"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_marginTop="90dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="#FFFFFF" />
    <!-- Start / Stop / Record Again button -->
    <ImageView
        android:id="@+id/imgRedRotIndicator"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:background="@drawable/ic_record_dot"
        android:translationZ="5dp"
        app:layout_constraintHorizontal_bias="0.08"
        app:layout_constraintEnd_toEndOf="@id/btnRecord"
        app:layout_constraintStart_toStartOf="@id/btnRecord"
        app:layout_constraintTop_toTopOf="@id/btnRecord"
        app:layout_constraintBottom_toBottomOf="@id/btnRecord"/>
    <Button
        android:id="@+id/btnRecord"
        android:layout_width="250dp"
        android:layout_height="40dp"
        android:text="@string/txt_start_recording"
        android:textColor="#E53935"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:drawablePadding="8dp"
        android:background="@drawable/bg_button_outlined_red"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>